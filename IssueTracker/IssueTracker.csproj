<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a6119f2c-59f4-45e5-9800-9e3bbc14195f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Services\CreateIssue\**" />
    <Compile Remove="Services\GetIssue\**" />
    <Content Remove="Services\CreateIssue\**" />
    <Content Remove="Services\GetIssue\**" />
    <EmbeddedResource Remove="Services\CreateIssue\**" />
    <EmbeddedResource Remove="Services\GetIssue\**" />
    <None Remove="Services\CreateIssue\**" />
    <None Remove="Services\GetIssue\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0" />
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
